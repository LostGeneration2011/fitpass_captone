        <mxCell id="arrow2" value="POST /forgot-password {email}" style="edgeStyle=elbowEdgeStyle;endArrow=block;html=1;strokeColor=#0D47A1;strokeWidth=2" edge="1" parent="1" source="frontend_box" target="backend_box">
          <mxGeometry relative="1" as="geometry"/>
